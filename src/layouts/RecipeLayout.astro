---
import MainGridLayout from './MainGridLayout.astro'

interface Props {
  title: string
  description?: string
  article?: boolean
}
const { title, description, article = false } = Astro.props
---
<MainGridLayout title={title} description={description} setOGTypeArticle={article}>
  <div class="recipe-shell">
    <slot />
  </div>
</MainGridLayout>

<style is:global>
  .recipe-shell {
    --recipe-paper: #f5f1e9;
    --recipe-ink: #252521;
    --recipe-muted: #746657;
    --recipe-rule: #d5cec3;
    color: var(--recipe-ink);
    background: var(--recipe-paper);
    width: 100%;
    min-height: 70vh;
    border-radius: var(--radius-large);
  }
  #main-grid:has(.recipe-shell) #content-wrapper {
    animation-delay: 100ms;
  }
  .dark .recipe-shell {
    --recipe-paper: #242421;
    --recipe-ink: #f1eee8;
    --recipe-muted: #c5b7a7;
    --recipe-rule: #514c45;
  }
  .recipe-content { width: 100%; padding: clamp(1.25rem, 2.5vw, 2rem); }
  .recipe-shell a { color: inherit; }
  .recipe-eyebrow, .recipe-kicker { font-size: .75rem; letter-spacing: .18em; color: var(--recipe-muted); }
  .recipe-pagination a:hover, .recipe-card:hover h3 { text-decoration: underline; text-underline-offset: .25em; }
  .recipe-header { margin: 1.8rem 0; }
  .recipe-header h1, .recipe-catalog-title { font-family: Georgia, 'Noto Serif SC', serif; font-weight: 500; letter-spacing: .04em; line-height: 1.2; }
  .recipe-header h1 { font-size: clamp(1.75rem, 2.5vw, 2.5rem); margin: .6rem 0; }
  .recipe-subtitle { color: var(--recipe-muted); font-family: Georgia, serif; font-size: 1.15rem; font-style: italic; }
  .recipe-meta { color: var(--recipe-muted); margin-top: 1.25rem; font-size: .9rem; }
  .recipe-figure { position: relative; min-width: 0; width: 100%; align-self: start; }
  .recipe-photo-frame { position: relative; width: 100%; overflow: hidden; background: var(--recipe-rule); }
  .recipe-photo-frame--cover { aspect-ratio: 4 / 5; }
  .recipe-photo-frame--detail { aspect-ratio: 4 / 3; }
  .recipe-photo-frame picture { position: absolute; inset: 0; width: 100%; height: 100%; }
  .recipe-photo-frame img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; max-width: none; max-height: none; object-fit: cover; object-position: 50% 50%; }
  .recipe-figure figcaption { position: absolute; top: 100%; left: 0; right: 0; font-size: .72rem; letter-spacing: .1em; color: var(--recipe-muted); padding-top: .5rem; }
  .recipe-portrait { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); grid-template-rows: auto 1fr; column-gap: clamp(1.5rem, 4vw, 4rem); align-items: start; margin-top: 2rem; }
  .recipe-portrait.image-right { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
  .recipe-portrait .recipe-figure { grid-column: 1; grid-row: 1 / 3; }
  .recipe-portrait .recipe-header { grid-column: 2; grid-row: 1; }
  .recipe-portrait .recipe-sections { grid-column: 2; grid-row: 2; }
  .recipe-portrait.image-right .recipe-figure { grid-column: 2; }
  .recipe-portrait.image-right .recipe-header, .recipe-portrait.image-right .recipe-sections { grid-column: 1; }
  .recipe-portrait .recipe-header { margin-top: 0; }
  .recipe-duet-photos { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); grid-template-rows: auto 1fr; column-gap: clamp(1rem, 3vw, 3rem); row-gap: 0; align-items: start; margin-top: 2rem; }
  .recipe-duet-photos.large-right { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
  .recipe-duet-photos .recipe-cover { grid-column: 1; grid-row: 1 / 3; }
  .recipe-duet-photos .recipe-detail { grid-column: 2; grid-row: 1; align-self: start; }
  .recipe-duet-photos .recipe-header { grid-column: 2; grid-row: 2; align-self: center; min-width: 0; margin: 0; }
  .recipe-duet-photos.large-right .recipe-cover { grid-column: 2; }
  .recipe-duet-photos.large-right .recipe-detail, .recipe-duet-photos.large-right .recipe-header { grid-column: 1; }
  .recipe-duet-photos.small-bottom { grid-template-rows: 1fr auto; }
  .recipe-duet-photos.small-bottom .recipe-header { grid-row: 1; }
  .recipe-duet-photos.small-bottom .recipe-detail { grid-row: 2; }
  .recipe-duet-writing { margin-top: clamp(2rem, 5vw, 5rem); }
  .recipe-duet-writing .recipe-sections { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: clamp(2rem, 6vw, 6rem); border-top: 1px solid var(--recipe-rule); padding-top: 2rem; }
  .recipe-ingredients h2, .recipe-method h2 { font-size: 1.3rem; font-weight: 500; margin-bottom: 1.5rem; }
  .recipe-ingredients h2 span, .recipe-method h2 span { display: block; font: .7rem Georgia, serif; letter-spacing: .16em; color: var(--recipe-muted); margin-top: .35rem; }
  .ingredient-group { margin: 1.2rem 0; }
  .ingredient-group h3 { font-size: .8rem; color: var(--recipe-muted); margin-bottom: .45rem; }
  .ingredient-group li { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--recipe-rule); padding: .6rem 0; }
  .ingredient-group li span:last-child { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .recipe-method { margin-top: 2rem; }
  .recipe-duet-writing .recipe-method { margin-top: 0; }
  .recipe-method li { display: grid; grid-template-columns: 2rem 1fr; gap: .75rem; padding: .8rem 0; border-top: 1px solid var(--recipe-rule); line-height: 1.8; }
  .step-number { font: .8rem Georgia, serif; color: var(--recipe-muted); padding-top: .3rem; }
  .recipe-method small { display: block; color: var(--recipe-muted); margin-top: .3rem; }
  .recipe-pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; border-top: 1px solid var(--recipe-rule); margin-top: 4rem; padding-top: 1.5rem; }
  .recipe-pagination > div:last-child { text-align: right; }
  .recipe-pagination a { display: inline-block; min-height: 44px; }
  .recipe-pagination small { display: block; color: var(--recipe-muted); font-size: .75rem; margin-bottom: .35rem; }
  .recipe-page-count { text-align: center; font-variant-numeric: tabular-nums; }
  .recipe-catalog-title { font-size: clamp(3.5rem, 7vw, 5.5rem); margin: 2rem 0 1rem; }
  .recipe-catalog-lead { color: var(--recipe-muted); max-width: 38rem; line-height: 1.8; }
  .recipe-catalog-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 3vw, 3rem); margin-top: 3rem; }
  .recipe-card:first-child { grid-column: span 2; }
  .recipe-card img { aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 50%; width: 100%; }
  .recipe-card:first-child img { aspect-ratio: 16 / 9; }
  .recipe-card p { color: var(--recipe-muted); font-size: .75rem; letter-spacing: .1em; margin-top: .8rem; }
  .recipe-card h3 { font-family: Georgia, 'Noto Serif SC', serif; font-size: clamp(1.25rem, 2vw, 1.8rem); margin-top: .3rem; }
  .recipe-empty { border-top: 1px solid var(--recipe-rule); margin-top: 3rem; padding-top: 2rem; color: var(--recipe-muted); }
  @media (max-width: 1200px) {
    .recipe-portrait, .recipe-portrait.image-right, .recipe-duet-writing .recipe-sections { display: block; }
    .recipe-portrait .recipe-figure, .recipe-portrait.image-right .recipe-figure { margin: 1.5rem 0 2rem; }
    .recipe-portrait { display: flex; flex-direction: column; gap: 0; }
    .recipe-portrait .recipe-header { order: 0; width: 100%; }
    .recipe-portrait .recipe-figure { order: 1; width: 100%; }
    .recipe-portrait .recipe-sections { order: 2; width: 100%; }
    .recipe-duet-photos, .recipe-duet-photos.large-right { display: flex; flex-direction: column; row-gap: 2rem; }
    .recipe-duet-photos .recipe-cover, .recipe-duet-photos .recipe-detail { width: 100%; }
    .recipe-duet-photos .recipe-header { order: -1; width: 100%; margin: 0 0 1rem; }
    .recipe-duet-writing { display: contents; }
    .recipe-duet { display: flex; flex-direction: column; }
    .recipe-duet .recipe-duet-photos { order: 1; }
    .recipe-duet .recipe-sections { order: 2; margin-top: 2rem; }
    .recipe-duet .recipe-method { margin-top: 2rem; }
  }
  @media (max-width: 480px) { .recipe-catalog-grid { grid-template-columns: 1fr; } .recipe-card:first-child { grid-column: span 1; } .recipe-pagination { gap: .4rem; font-size: .85rem; } }
</style>
